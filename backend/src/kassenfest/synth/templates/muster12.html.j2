{% extends "_page.html.j2" %}
{% block style %}
.head { display: grid; grid-template-columns: 1fr 62mm; gap: 0; }
.ins { display: grid; grid-template-columns: 1fr 1fr 27mm; }
.ins .wide { grid-column: span 2; }
.ins .full { grid-column: span 3; }
.ins .cell { min-height: 10mm; }
.title { padding: 2mm 3mm; border: 0.25mm solid {{ form_ink }}; border-left: none; }
.title h1 { font-size: 13pt; margin: 0 0 1mm; line-height: 1.1; font-weight: 700; }
.title .no { position: absolute; right: 3mm; top: 2mm; font-size: 18pt; font-weight: 700; }
.ticks { margin-top: 2mm; display: grid; grid-template-columns: 1fr; row-gap: 1.6mm; font-size: 7.5pt; }
.ticks label { display: flex; align-items: center; gap: 2mm; }
.period { margin-top: 3mm; font-size: 7.5pt; display: grid; grid-template-columns: 9mm 1fr; row-gap: 2mm; align-items: end; }
.period span.line { border-bottom: 0.2mm solid {{ form_ink }}; min-height: 6mm; display: block; }
.block { border: 0.25mm solid {{ form_ink }}; border-top: none; padding: 1.2mm 1.6mm; min-height: 11mm; }
table.m { width: 100%; border-collapse: collapse; font-size: 7.5pt; table-layout: fixed; }
table.m th:nth-child(1) { width: 44mm; }
table.m th:nth-child(3) { width: 22mm; }
table.m th:nth-child(4), table.m th:nth-child(5) { width: 23mm; }
table.m td .pr { white-space: pre-wrap; font-size: 9pt; }
table.m th { font-weight: 400; font-size: 6.5pt; text-align: left; border: 0.25mm solid {{ form_ink }}; padding: 0.6mm 1mm; background: {{ shade }}; }
table.m td { border: 0.25mm solid {{ form_ink }}; padding: 0.4mm 1mm; height: 11.5mm; vertical-align: middle; }
table.m td.cat { width: 44mm; }
table.m td.cat label { display: flex; align-items: center; gap: 1.6mm; }
table.m td.n { width: 22mm; text-align: center; }
table.m td.d { width: 21mm; text-align: center; }
.section { font-weight: 700; font-size: 8pt; margin: 2.5mm 0 1mm; }
.foot { display: grid; grid-template-columns: 1fr 1fr; margin-top: 3mm; }
.foot .cell { height: 34mm; padding: 1mm 2mm; }
.foot .cell .lbl { position: absolute; bottom: 1mm; left: 2mm; }
{% endblock %}
{% block form %}
<div class="head">
  <div class="ins">
    <div class="cell full"><span class="lbl">Krankenkasse bzw. Kostenträger</span>{{ c.payer_name }}</div>
    <div class="cell wide"><span class="lbl">Name, Vorname des Versicherten</span>{{ c.patient_name }}</div>
    <div class="cell"><span class="lbl">geb. am</span>{{ c.patient_dob }}</div>
    <div class="cell"><span class="lbl">Kostenträgerkennung</span>{{ c.payer_ik }}</div>
    <div class="cell"><span class="lbl">Versicherten-Nr.</span>{{ c.kvnr }}</div>
    <div class="cell"><span class="lbl">Status</span>{{ c.status }}</div>
    <div class="cell"><span class="lbl">Betriebsstätten-Nr.</span>{{ c.bsnr }}</div>
    <div class="cell"><span class="lbl">Arzt-Nr.</span>{{ c.lanr }}</div>
    <div class="cell"><span class="lbl">Datum</span>{{ c.issue_date }}</div>
  </div>
  <div class="title cell">
    <span class="no">12</span>
    <h1>Verordnung<br>häuslicher<br>Krankenpflege</h1>
    <div class="ticks">
      <label>{{ c.kind_erst }} Erstverordnung</label>
      <label>{{ c.kind_folge }} Folgeverordnung</label>
      <label>{{ c.accident }} Unfall, Unfallfolgen</label>
      <label>{{ c.blank }} Blankoverordnung</label>
    </div>
    <div class="period">
      <span>vom</span><span class="line">{{ c.period_from }}</span>
      <span>bis</span><span class="line">{{ c.period_to }}</span>
    </div>
  </div>
</div>
<div class="block"><span class="lbl">Verordnungsrelevante Diagnose(n) (ICD-10-Code)</span>{{ c.icd_codes }}</div>
<div class="block"><span class="lbl">Einschränkungen, die häusliche Krankenpflege erforderlich machen</span>{{ c.limitations }}</div>

<div class="section">Behandlungspflege</div>
<table class="m">
  <tr><th>Maßnahme</th><th>Präparat / Wundart, Lokalisation, Größe, Grad / Hinweise</th><th>Häufigkeit</th><th>Dauer vom</th><th>bis</th></tr>
  {% for row in rows %}
  <tr>
    <td class="cat"><label>{{ row.tick }} {{ row.label }}</label></td>
    <td>{{ row.details }}</td>
    <td class="n">{{ row.frequency }}</td>
    <td class="d">{{ row.duration_from }}</td>
    <td class="d">{{ row.duration_to }}</td>
  </tr>
  {% endfor %}
</table>

<div class="block" style="border-top: 0.25mm solid {{ form_ink }}; margin-top: 2.5mm;">
  <span class="lbl">Weitere Hinweise</span>{{ c.further_notes }}
</div>

<div class="foot">
  <div class="cell">{{ c.practice_stamp }}<span class="lbl">Vertragsarztstempel</span></div>
  <div class="cell" style="border-left: none;">{{ c.doctor_signature }}<span class="lbl">Unterschrift des Arztes</span></div>
</div>
{% endblock %}
