# Copy to .env (gitignored) and fill in. Read by backend/src/kassenfest/config.py.

# Meta Model API key from https://dev.meta.ai
MODEL_API_KEY=

# live   = always call the API, overwrite the cache
# record = use the cache, call the API on a miss (default)
# replay = cache only, no API key needed (demo / judges)
LLM_MODE=record
