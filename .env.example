# Copy to .env (gitignored) and fill in. Read by backend/src/kassenfest/config.py.

# Meta Model API key from https://dev.meta.ai
MODEL_API_KEY=

# live   = always call the API, overwrite the cache
# record = use the cache, call the API on a miss (default)
# replay = cache only, no API key needed (demo / judges)
LLM_MODE=record

# Replay at the recorded pace: 1 = as slow as the live run, 0.3 = faster, 0 = instant (default)
LLM_REPLAY_PACE=0

# Pin "today": countdowns and the fixer agent's deadlines count from it, and a replayed demo
# asks the model exactly what the recording did. The demo set was recorded on this date.
TODAY=2026-11-05
